{
  "compilerOptions": {
    "strict": true,
    "target": "ES2025",
    "lib": ["ES2025"],
    "module":"Node20",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "sourceMap": true,
    "rootDir": "src"
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules"
  ],
  "overrides": {
    "@typescript-eslint/typescript-estree@8.72.1": {
      "minimatch": "11.0.4"
    }
  }
}
